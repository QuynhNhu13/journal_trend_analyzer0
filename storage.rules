rules_version = '2';

// Cloud Storage security rules for Journal Trend Analyzer.
//
// The app uploads exported PDFs to `reports/<fileName>`; the web admin lists
// those files (to show sizes) and deletes them. Only `reports/` is used by the
// app today, so everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = signed-in user whose email is in the Firestore admins allowlist.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Exported PDF reports.
    //  - read   : any signed-in user (the app reads its own uploads; the admin
    //             console lists the folder to compute sizes).
    //  - create/update : any signed-in user — the Flutter app uploads here.
    //  - delete : admins only (Reports page "Delete" action).
    match /reports/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Deny all other paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
