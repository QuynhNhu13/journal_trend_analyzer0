rules_version = '2';

// Cloud Storage security rules for Journal Trend Analyzer.
//
// The app uploads exported PDFs to `reports/<fileName>`; the web admin lists
// those files (to show sizes) and deletes them. Only `reports/` is used by the
// app today, so everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = signed-in user whose email is in the Firestore admins allowlist.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Exported PDF reports + the admin File Manager subtree (recursive so nested
    // folders created from the web work too).
    //  - read   : any signed-in user (the app reads its own uploads; the admin
    //             console lists folders and computes sizes).
    //  - create/update : any signed-in user — the Flutter app uploads exports
    //             here, and admins upload/rename/create folders from the web.
    //  - delete : admins only (File Manager delete / rename-then-delete).
    match /reports/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Admin Storage manager: an administrator may browse, upload, rename and
    // delete anywhere in the bucket from the web console. The app itself only
    // ever touches `reports/` (covered by the more permissive rule above).
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
