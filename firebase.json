{
  "hosting": {
    "public": "admin_web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "journal-trend-analyzer-3f87b",
          "appId": "1:442283477331:android:6c29df5c0df0184b5639a6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "journal-trend-analyzer-3f87b",
          "configurations": {
            "android": "1:442283477331:android:6c29df5c0df0184b5639a6",
            "ios": "1:442283477331:ios:2a165f1354f398ec5639a6",
            "macos": "1:442283477331:ios:49437590f3ead03d5639a6",
            "web": "1:442283477331:web:2f01f96f65c38e705639a6",
            "windows": "1:442283477331:web:b9d1e9372754c50e5639a6"
          }
        }
      }
    }
  }
}
